                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });\nconst data = pm.response.json();\nif (data.bookingid) {\n  pm.collectionVariables.set(\"bookingId\", String(data.bookingid));\n  pm.environment.set(\"bookingId\", String(data.bookingid));\n  console.log(\"Booking ID saved: \" + data.bookingid);\n}"
                ]
              }
            }
          ],
